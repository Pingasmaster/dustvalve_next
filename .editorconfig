root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_code_style = intellij_idea
# @Composable PascalCase is standard; keep naming for non-composables.
# (ktlint already supports this via ignore_when_annotated_with; do not disable
# function-naming entirely.)
ktlint_function_naming_ignore_when_annotated_with = Composable
# KEEP disabled: Compose theme / CompositionLocal conventions (LocalFoo,
# AppTypography) clash with lowerCamelCase. ktlint 1.8 property-naming has no
# Local*/PascalCase allowlist - only constant_naming - so the rule must stay off.
ktlint_standard_property-naming = disabled
# KEEP disabled: several types use private `_state` MutableStateFlow with
# derived public flows (not a matching `state` property). ktlint
# backing-property-naming requires a same-name public property/function and
# has no allowlist; enabling it fails QueueManager / PlayerViewModel / etc.
ktlint_standard_backing-property-naming = disabled
# Multi-declaration files (e.g. Shape.kt hosting AppShapes) are intentional;
# filename matching would force artificial one-type-per-file churn.
ktlint_standard_filename = disabled

# Tests often embed long JSON fixtures; lift the line-length cap there.
[**/src/test/**.{kt,kts}]
max_line_length = off
ktlint_standard_max-line-length = disabled

[**/src/androidTest/**.{kt,kts}]
max_line_length = off
ktlint_standard_max-line-length = disabled
